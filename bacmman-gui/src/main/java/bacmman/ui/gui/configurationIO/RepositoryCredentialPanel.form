<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="bacmman.ui.gui.configurationIO.RepositoryCredentialPanel">
  <grid id="27dc6" binding="credentialPanel" layout-manager="GridLayoutManager" row-count="2" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="180"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="7f2b4" class="javax.swing.JComboBox" binding="repositoryType">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="GitHub"/>
            <item value="GitLab"/>
            <item value="Local"/>
          </model>
          <toolTipText value="&lt;html&gt;Type of repository:&lt;br /&gt;GitHub: items are stored as gists of a GitHub account&lt;br /&gt;GitLab: items are stored as personal snippets of a GitLab account (gitlab.com or self-hosted server)&lt;br /&gt;Local: items are stored in a folder of the file system&lt;/html&gt;"/>
        </properties>
      </component>
      <component id="9d0e5" class="javax.swing.JTextField" binding="serverURL">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
        </constraints>
        <properties>
          <text value="https://gitlab.com"/>
          <toolTipText value="URL of the GitLab server (gitlab.com or a self-hosted server, possibly with a path). Press Enter to load the last username used on this server. Right click: recent list"/>
        </properties>
      </component>
      <hspacer id="1c7e3">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <component id="5b658" class="javax.swing.JButton" binding="generateToken">
        <constraints>
          <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Generate Token"/>
          <toolTipText value="Generate a token for this account and store it encrypted with the password"/>
        </properties>
      </component>
      <component id="a8cdf" class="javax.swing.JButton" binding="loadToken">
        <constraints>
          <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Connect"/>
          <toolTipText value="Load the token stored for this account (decrypted with the password) and load the items of the account"/>
        </properties>
      </component>
      <grid id="c3a1e" binding="fieldPanel" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="5" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="4b7a9" class="javax.swing.JTextField" binding="localFolder">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <toolTipText value="Folder of the local repository. Press Enter or click Open to load it (it is created if it does not exist). Right click: recent list"/>
            </properties>
          </component>
          <component id="e8c62" class="javax.swing.JButton" binding="browseFolder">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="..."/>
              <toolTipText value="Choose the folder of the local repository"/>
            </properties>
          </component>
          <grid id="b267e" binding="usernamePanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="d83f0" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Username:"/>
                </properties>
              </component>
              <component id="d83ff" class="javax.swing.JTextField" binding="username">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
                </constraints>
                <properties>
                  <text value="bacmman"/>
                  <toolTipText value="Username of the GitHub / GitLab account that contains the items. Press Enter to load them. Right click: recent list (shared by all panels, distinct for GitHub and each GitLab server)"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="e5459" binding="passwordPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="a7640" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Password:"/>
                </properties>
              </component>
              <component id="a7642" class="javax.swing.JPasswordField" binding="password">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
                </constraints>
                <properties>
                  <toolTipText value="&lt;html&gt;Password used to encrypt the GitHub / GitLab token when it is generated, and to decrypt it when connecting. &lt;br /&gt;Without password, only public items can be loaded (click &lt;em&gt;Load Public&lt;/em&gt;), and items cannot be created, modified or deleted. &lt;br /&gt;The password is kept in memory until BACMMAN is closed, it is never saved on disk.&lt;/html&gt;"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
